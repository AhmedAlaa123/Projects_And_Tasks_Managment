@using Ui.Models.Auth
@model LoginViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
</head>
<body class="bg-light">

    <div class="container d-flex justify-content-center align-items-center min-vh-100">
        <div class="card shadow-sm" style="width: 420px; border-radius: 12px;">
            <div class="card-body p-5">

                <div class="text-center mb-4">
                    <h4 class="fw-semibold">Welcome back</h4>
                    <p class="text-muted small">Sign in to your account</p>
                </div>

                <form asp-action="Login" asp-controller="auth" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label small fw-semibold">User Name</label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label asp-for="Password" class="form-label small fw-semibold">Password</label>
                            <a asp-action="ForgotPassword" class="small text-primary text-decoration-none">Forgot password?</a>
                        </div>
                        <div class="input-group">
                            <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" id="password" />
                            <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()">
                                <i id="eye-icon" class="bi bi-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check">
                        <input asp-for="RememberMe" class="form-check-input" type="checkbox" />
                        <label asp-for="RememberMe" class="form-check-label small text-muted">Remember me for 30 days</label>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger small py-2">
                            @Html.ValidationSummary(false)
                        </div>
                    }

                    <button type="submit" class="btn btn-primary w-100 py-2">Sign in</button>

                    <div class="text-center mt-3 small text-muted">
                        Don't have an account?
                        <a asp-action="Register" class="text-primary text-decoration-none fw-semibold">Create one</a>
                    </div>
                </form>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function togglePassword() {
            const input = document.getElementById('password');
            const icon  = document.getElementById('eye-icon');
            input.type  = input.type === 'password' ? 'text' : 'password';
            icon.className = input.type === 'password' ? 'bi bi-eye' : 'bi bi-eye-slash';
        }
    </script>

</body>
</html>