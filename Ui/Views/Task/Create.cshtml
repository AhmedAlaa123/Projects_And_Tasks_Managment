@using Ui.Services.Dtos
@model CreateTaskDto
@{
    ViewData["Title"] = "Create Task";
    var projectId = ViewBag.ProjectId as int? ?? 0;
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <div class="d-flex align-items-center gap-2">
                        <a asp-controller="Task" asp-action="Index"
                           asp-route-projectId="@projectId"
                           class="btn btn-sm btn-outline-secondary">
                            Back
                        </a>
                        <h5 class="fw-semibold mb-0">Create Task</h5>
                    </div>
                </div>

                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <input type="hidden" asp-for="ProjectId" value="@projectId" />

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label small fw-semibold"></label>
                            <input asp-for="Title" class="form-control" placeholder="Enter task title" />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label small fw-semibold"></label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Enter task description"></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Status" class="form-label small fw-semibold"></label>
                                <select asp-for="Status" class="form-select"
                                        asp-items="Html.GetEnumSelectList<Domain.Enums.TaskStatus>()">
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Priority" class="form-label small fw-semibold"></label>
                                <select asp-for="Priority" class="form-select"
                                        asp-items="Html.GetEnumSelectList<Domain.Enums.TaskPriority>()">
                                </select>
                                <span asp-validation-for="Priority" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DueDate" class="form-label small fw-semibold"></label>
                            <input asp-for="DueDate" type="date" class="form-control"
                                   min="@DateTime.UtcNow.ToString("yyyy-MM-dd")" />
                            <span asp-validation-for="DueDate" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i> Create
                            </button>
                            <a asp-action="Index" asp-route-projectId="@projectId"
                               class="btn btn-outline-secondary">Cancel</a>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}