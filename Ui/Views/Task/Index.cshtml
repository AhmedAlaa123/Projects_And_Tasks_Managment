@using Ui.Services.Dtos
@model List<TaskDto>
@{
    ViewData["Title"] = "Tasks";
    var projectId = ViewBag.ProjectId as int? ?? 0;
}

<div class="container-fluid mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div class="d-flex align-items-center gap-2">
            <a asp-controller="Project" asp-action="Index"
               class="btn btn-sm btn-outline-secondary">
                Back
            </a>
            <div>
                <h4 class="fw-semibold mb-0">Tasks</h4>
                <small class="text-muted">Project #@projectId</small>
            </div>
        </div>
        <a asp-action="Create" asp-route-projectId="@projectId" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i> New Task
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm border-0">

        <div class="card-header bg-white py-3">
            <div class="input-group" style="max-width: 300px;">
                <span class="input-group-text bg-white">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" id="searchInput" class="form-control border-start-0"
                       placeholder="Search tasks..." />
            </div>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4" style="width: 60px;">#</th>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Due Date</th>
                            <th class="text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody id="taskTableBody" style="min-height:500px">
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-5">
                                    <i class="bi bi-clipboard2 fs-3 d-block mb-2"></i>
                                    No tasks found
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var task in Model)
                            {
                                <tr>
                                    <td class="ps-4 text-muted">@task.Id</td>
                                    <td>
                                        <span class="fw-semibold">@task.Title</span>
                                        <br />
                                        <small class="text-muted">
                                            @(task.Description.Length > 50
                                                                                ? task.Description.Substring(0, 50) + "..."
                                                                                : task.Description)
                                </small>
                            </td>
                            <td>
                                @{
                                            var statusClass = task.Status switch
                                            {
                                                Domain.Enums.TaskStatus.Todo => "bg-secondary",
                                                Domain.Enums.TaskStatus.InProgress => "bg-warning text-dark",
                                                Domain.Enums.TaskStatus.Done => "bg-success",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass">@task.Status</span>
                                    </td>
                                    <td>
                                        @{
                                            var priorityClass = task.Priority switch
                                            {
                                                Domain.Enums.TaskPriority.Low => "text-success",
                                                Domain.Enums.TaskPriority.Medium => "text-warning",
                                                Domain.Enums.TaskPriority.High => "text-danger",
                                                _ => "text-secondary"
                                            };
                                        }
                                        <span class="fw-semibold @priorityClass">
                                            <i class="bi bi-flag-fill me-1"></i>@task.Priority
                                        </span>
                                    </td>
                                    <td class="text-muted">
                                        <i class="bi bi-calendar3 me-1"></i>
                                        @task.DueDate.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-center">
                                        @* ✅ Update Status *@
                                        <div class="dropdown d-inline me-1">
                                            <button class="btn btn-sm btn-outline-primary dropdown-toggle"
                                                    data-bs-toggle="dropdown">
                                                <i class="bi bi-arrow-repeat"></i>
                                            </button>
                                            <ul class="dropdown-menu">
                                                @foreach (Domain.Enums.TaskStatus status in Enum.GetValues(typeof(Domain.Enums.TaskStatus)))
                                                {
                                                    <li>
                                                        <form asp-action="UpdateStatus" method="post">
                                                            @Html.AntiForgeryToken()
                                                            <input type="hidden" name="id" value="@task.Id" />
                                                            <input type="hidden" name="projectId" value="@projectId" />
                                                            <input type="hidden" name="status" value="@((int)status)" />
                                                            <button type="submit" class="dropdown-item">
                                                                @status
                                                            </button>
                                                        </form>
                                                    </li>
                                                }
                                            </ul>
                                        </div>

                                 
                                        <a asp-action="Edit"
                                           asp-route-id="@task.Id"
                                           asp-route-projectId="@projectId"
                                           asp-route-title="@task.Title"
                                           asp-route-description="@task.Description"
                                           asp-route-status="@((int)task.Status)"
                                           asp-route-priority="@((int)task.Priority)"
                                           asp-route-dueDate="@task.DueDate.ToString("yyyy-MM-dd")"
                                           asp-route-projectId="@task.ProjectId"
                                           class="btn btn-sm btn-outline-warning me-1">
                                            Edit
                                        </a>

                              
                                        <form asp-action="Delete" method="post" class="d-inline"
                                              onsubmit="return confirm('Are you sure?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@task.Id" />
                                            <input type="hidden" name="projectId" value="@projectId" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                              Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="card-footer bg-white py-2">
            <small class="text-muted">
                Total: <strong>@Model.Count</strong> tasks
            </small>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('keyup', function () {
            const value = this.value.toLowerCase();
            const rows  = document.querySelectorAll('#taskTableBody tr');
            rows.forEach(row => {
                row.style.display = row.textContent.toLowerCase().includes(value) ? '' : 'none';
            });
        });
    </script>
}